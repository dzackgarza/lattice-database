source "$HOME/.envrc"

# The Sage launcher runs in a container that bind-mounts /home/dzack but not
# /tmp, so QC scratch must live in the repository's own scratch surface.
export TMPDIR="$PWD/.tmp"

# Database orchestration consumes the research preamble.
export PYTHONPATH="$PWD/src:$HOME/research/src${PYTHONPATH:+:$PYTHONPATH}"
export MYPYPATH="$HOME/research/src${MYPYPATH:+:$MYPYPATH}"
