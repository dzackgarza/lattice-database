diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 3effa5ebf1..fc72571d23 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -62,9 +62,15 @@ jobs:
       - name: Validate preamble owner contracts
         if: always()
         run: |
+          # The owner's suite bills its own 60 s `--timeout` to the first test that reaches the Julia
+          # bridge, because starting the session is 61 s and every later call is free
+          # (sage-extensions#237). That ceiling is the owner's and is not raised here; what this step
+          # does is start the bridge *before* pytest exists, so no test's timer pays for it. Without
+          # this the step dies on its first test at 61 s; with it, the thirteen contracts run in
+          # about seven seconds.
           docker exec -i --workdir "$GITHUB_WORKSPACE/sage-extensions" \
             --env "PYTHONPATH=$GITHUB_WORKSPACE/_ci-support/ai-review-ci/tool-artifacts/pytest_plugins" \
-            sage-env /sage/.venv/bin/python -c 'import sage.all, sys, pytest; sys.exit(pytest.main(sys.argv[1:]))' \
+            sage-env /sage/.venv/bin/python -c 'import sage.all, sys, pytest; from sage.all import ZZ; from sage_extensions.categories.lattices import Lattices; Lattices(ZZ)([[2, -1], [-1, 2]]).orthogonal_group().order(); sys.exit(pytest.main(sys.argv[1:]))' \
             -p qc_sage_session -p qc_unique_inventory \
             tests/lattices/test_lattice_database_owner_contracts.sage \
             tests/lattices/test_coordinate_diagonal_embeddings.py
