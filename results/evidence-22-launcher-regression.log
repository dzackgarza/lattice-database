# #22: the recovery launcher requires a distinct result for every expected item, and the guest's status
#
# Both runs below are the same six controlled guests, inside the published image (sage-image/run.sh,
# proot), through results/launcher-regression.sh. The first is the launcher of record.

$ sh results/launcher-regression.sh
case normal: launcher rc=0 (want 0), PYEXIT=0, results=2  [two results and the summary: the only case that may pass]
case duplicate: launcher rc=1 (want 1), PYEXIT=0, results=2  [one item reported twice: the other item produced no result]
case incomplete: launcher rc=1 (want 1), PYEXIT=0, results=2  [two results, no summary: a clean exit must still fail]
case short: launcher rc=1 (want 1), PYEXIT=0, results=1  [one result of two: a clean exit must still fail]
case raise: launcher rc=1 (want 1), PYEXIT=1, results=2  [a nonzero guest status must fail]
case segv: launcher rc=1 (want 1), PYEXIT=139, results=2  [a signal death the wrapper reports as 0 must fail]
wrapper: verify-launcher.sh
REGRESSION PASS
exit=0

$ sh results/launcher-regression.sh results/verify-launcher-unrepaired.sh
case normal: launcher rc=0 (want 0), PYEXIT=absent, results=2  [two results and the summary: the only case that may pass]
case duplicate: launcher rc=0 (want 1), PYEXIT=absent, results=2  [one item reported twice: the other item produced no result]
REGRESSION FAIL: duplicate gave rc 0, wanted 1
case incomplete: launcher rc=0 (want 1), PYEXIT=absent, results=2  [two results, no summary: a clean exit must still fail]
REGRESSION FAIL: incomplete gave rc 0, wanted 1
case short: launcher rc=0 (want 1), PYEXIT=absent, results=1  [one result of two: a clean exit must still fail]
REGRESSION FAIL: short gave rc 0, wanted 1
case raise: launcher rc=1 (want 1), PYEXIT=absent, results=2  [a nonzero guest status must fail]
case segv: launcher rc=0 (want 1), PYEXIT=absent, results=2  [a signal death the wrapper reports as 0 must fail]
REGRESSION FAIL: segv gave rc 0, wanted 1
wrapper: verify-launcher-unrepaired.sh
REGRESSION FAIL
