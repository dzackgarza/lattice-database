+        echo "::error::${message} They are on this job's certify- branch and in its uploaded certification artifact; the run continues."
+        echo "### ${message}" >> "$GITHUB_STEP_SUMMARY"
+        echo "Recover them from branch \`certify-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.shard }}\` or from this job's \`certification-\` artifact." >> "$GITHUB_STEP_SUMMARY"
     - name: Stop the Sage environment
       if: always()
       shell: bash --noprofile --norc -e -o pipefail {0}
