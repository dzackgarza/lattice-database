+def test_each_card_states_the_lattice_the_count_belongs_to() -> None:
+    r"""The card's rank, signature, determinant and Gram are the lattice's, so the counts are its counts.
+
+    A rank-and-signature check alone would not say the Gram matrix was read: the
+    determinant and the form itself are compared too, entrywise.
+    """
+    for tag in ("6JRS", "6JRT", "6JRU", "6JRV", "6JRW"):
+        row_set = stated(tag)
+        lattice = lattice_of(tag)
+        basis = tuple(lattice.module_generators())
+        assert int(lattice.module_rank()) == int(row_set["rank"]), tag
+        assert [int(entry) for entry in lattice.signature()] == [int(entry) for entry in row_set["signature"]], tag
+        assert int(lattice.determinant()) == int(row_set["determinant"]), tag
+        assert [[int(lattice.b(left, right)) for right in basis] for left in basis] == row_set["gram"], tag
+
