+def test_the_rows_are_certified_by_computation_and_not_cited() -> None:
+    r"""Each row names a certificate and no citation, which is what the count has.
+
+    A cited row would carry a ``reference`` and would not need a certificate; these
+    rows have no source, so the card's stamp is the whole provenance of the number,
+    and a row that arrived without one would be a number nothing establishes.  The
+    stamp is hexadecimal, which a citation's prose is not.
+    """
+    for tag in ("6JRS", "6JRT", "6JRU", "6JRV", "6JRW"):
+        stamp = stated(tag)["certification"]
+        assert set(stamp) <= set("0123456789abcdef"), (tag, stamp)
+        assert stamp != "", (tag, stamp)
+        for name in STATED_SUBGROUPS:
+            assert stated(tag)["rows"][name]["cited"] is False, (tag, name)
