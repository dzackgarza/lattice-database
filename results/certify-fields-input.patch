--- a/.github/workflows/certify.yml
+++ b/.github/workflows/certify.yml
@@ -9,6 +9,11 @@ name: certify
           full corpus.
         required: false
         type: string
+      fields:
+        description: Computations to run, separated by spaces, such as `primitive_orbits[Otilde].planes`;
+          every field when absent.
+        required: false
+        type: string
 permissions:
   contents: write
 # The group is the run's, so no two runs compute the same card at once. The semi-decision searches
@@ -96,6 +101,7 @@ jobs:
     - name: Compute and certify uncertified card values
       env:
         LATTICEDB_TAG: ${{ matrix.tag }}
