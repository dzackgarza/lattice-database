diff --git a/.github/workflows/verify.yml b/.github/workflows/verify.yml
index 91c8967e21..4f86d454a4 100644
--- a/.github/workflows/verify.yml
+++ b/.github/workflows/verify.yml
@@ -80,11 +80,32 @@ jobs:
         uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
       - name: State the memory ceiling and give this shard its swap
         run: |
-          sudo fallocate -l "${SWAP_GIB}G" /swapfile || sudo dd if=/dev/zero of=/swapfile bs=1M count=$((SWAP_GIB * 1024))
-          sudo chmod 600 /swapfile
-          sudo mkswap -q /swapfile
-          sudo swapon /swapfile
-          echo "memory ceiling: ${SWAP_GIB} GiB swap on top of the runner's RAM"
+          # The ceiling this job is given, and what the runner actually grants. A hosted runner can
+          # refuse the swap file, so the probe below spends a megabyte finding that out: a refusal is
+          # recorded and the shard runs on the runner's memory alone, rather than a job that fails
+          # here -- or writes sixteen gigabytes to a disk that will not swap it.
+          swap_gib="${SWAP_GIB}"
+          probe=/swapfile-probe
+          granted=""
+          if sudo fallocate -l 1M "$probe" 2>/dev/null || sudo dd if=/dev/zero of="$probe" bs=1M count=1 status=none 2>/dev/null; then
+            if sudo chmod 600 "$probe" && sudo mkswap -q "$probe" >/dev/null 2>&1 && sudo swapon "$probe" 2>/dev/null; then
+              granted=1
+            fi
+            sudo swapoff "$probe" 2>/dev/null || true
+            sudo rm -f "$probe" || true
+          fi
+          if [ -z "$granted" ]; then
+            echo "::warning::the runner granted no swap; this shard runs on the runner's RAM alone (asked for ${swap_gib} GiB)"
+          elif sudo fallocate -l "${swap_gib}G" /swapfile 2>/dev/null || sudo dd if=/dev/zero of=/swapfile bs=1M count=$((swap_gib * 1024)) status=none; then
+            if sudo chmod 600 /swapfile && sudo mkswap -q /swapfile >/dev/null && sudo swapon /swapfile; then
+              echo "memory ceiling: ${swap_gib} GiB swap on top of the runner's RAM"
+            else
+              sudo rm -f /swapfile || true
+              echo "::warning::the swap file would not enable after the probe did; running on the runner's RAM alone"
+            fi
+          else
+            echo "::warning::the runner granted the probe but not ${swap_gib} GiB; running on the runner's RAM alone"
+          fi
           free -h
       - name: Provision the shared Sage environment
         uses: ./.github/actions/sage
